# Copie para .env (backend/.env). Este arquivo NUNCA vai para o git nem para o frontend.

# Provedor de IA: gemini (real) ou mock (resposta de teste, sem internet nem chave)
AI_PROVIDER=gemini

# Chave do Gemini (Google AI Studio). Cole só aqui.
GEMINI_API_KEY=
# Modelo. Se der erro de "modelo não encontrado", veja a lista atual em https://ai.google.dev/models
GEMINI_MODEL=gemini-3.8-flash

# Como o GAIA te chama e fuso horário usado na data/hora que ele "enxerga"
GAIA_USER_NAME=JP
GAIA_TIMEZONE=America/Sao_Paulo

# Servidor. 127.0.0.1 = só este computador. Use 0.0.0.0 para acessar de outros aparelhos da sua rede (sem senha ainda!)
PORT=8787
HOST=127.0.0.1

# Quantas mensagens anteriores o GAIA recebe como contexto
GAIA_HISTORY_CONTEXT=30
